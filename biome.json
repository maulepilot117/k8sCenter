{
  "$schema": "https://biomejs.dev/schemas/2.5.12/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": false,
    "includes": [
      "tools/theme-gen/**",
      "frontend/astro.config.mjs",
      "frontend/tsconfig.json",
      "frontend/package.json",
      "frontend/src/**",
      "frontend/server/**",
      "frontend/lib/**",
      "frontend/components/**"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 80
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "a11y": "off",
      "style": {
        "noNonNullAssertion": "off"
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always"
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "overrides": [
    {
      "includes": [
        "frontend/components/k8s/ResourceIcon.tsx",
        "frontend/components/ui/Alert.tsx",
        "frontend/components/ui/Button.tsx",
        "frontend/components/ui/Card.tsx",
        "frontend/components/ui/class-props_test.tsx",
        "frontend/components/ui/GlassCard.tsx",
        "frontend/components/ui/Input.tsx",
        "frontend/components/ui/RemoveButton.tsx",
        "frontend/components/ui/Select.tsx",
        "frontend/components/ui/Skeleton.tsx",
        "frontend/components/ui/Spinner.tsx",
        "frontend/components/velero/AssuranceBadges.tsx",
        "frontend/src/components/ui/Logo.tsx",
        "frontend/components/ui/cell-fill.ts",
        "frontend/lib/dashboard/types.ts",
        "frontend/lib/hooks/use-dirty-guard.ts",
        "frontend/lib/hooks/use-dirty-guard_test.tsx",
        "frontend/lib/hooks/use-namespaces.ts",
        "frontend/lib/hooks/use-poll.ts",
        "frontend/lib/hooks/use-poll_test.tsx",
        "frontend/lib/resource-columns.ts",
        "frontend/lib/resource-columns_test.ts",
        "frontend/lib/useWsRefetch.ts",
        "frontend/lib/useWsRefetch_test.tsx",
        "frontend/lib/wizard-primary-action.ts",
        "frontend/lib/yaml-apply.ts",
        "frontend/lib/yaml-apply_test.ts",
        "frontend/src/islands/VulnerabilityDetail_test.tsx",
        "frontend/src/lib/use-is-client.ts",
        "frontend/src/lib/use-is-client_test.tsx",
        "frontend/src/lib/signal-hooks.ts",
        "frontend/src/lib/signal-hooks_test.tsx",
        "frontend/src/lib/use-signal-value.ts",
        "frontend/src/lib/use-signal-value_test.tsx",
        "frontend/src/test-utils/render.tsx",
        "frontend/src/test-utils/render_test.tsx"
      ],
      "linter": {
        "domains": {
          "react": "recommended"
        }
      }
    },
    {
      "includes": ["**/*.astro"],
      "linter": {
        "enabled": false
      }
    }
  ]
}
