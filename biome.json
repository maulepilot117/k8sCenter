{
  "$schema": "https://biomejs.dev/schemas/2.5.12/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": false,
    "includes": [
      "tools/theme-gen/**",
      "frontend/astro.config.mjs",
      "frontend/tsconfig.json",
      "frontend/package.json",
      "frontend/src/**",
      "frontend/server/**",
      "frontend/lib/**",
      "frontend/components/**"
    ]
