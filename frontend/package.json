{
  "name": "@k8scenter/frontend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "start": "bun run server/prod.ts",
    "test": "bun test",
    "lint": "biome lint ../",
    "fmt": "biome format --write ../",
    "fmt:check": "biome format ../",
    "check": "biome check ../ && astro check && bun run server/check-no-ws-dev-proxy.ts && bun run server/check-no-signal-store-in-ssr.ts && bun run server/check-island-hydration-directives.ts && bun run server/check-lockfile-is-text.ts && bun run server/check-no-duplicate-lib-state.ts && bun run server/check-no-render-is-browser.ts && bun run server/check-e2e-specs-in-testdir.ts && bun run server/check-internal-links.ts && bun run server/check-tailwind-colors.ts && bun run server/check-no-preact.ts && bun run server/check-css-vars.ts"
  },
  "dependencies": {
    "astro": "7.4.1",
    "@astrojs/node": "^11.1.5",
    "@astrojs/react": "7.1.4",
    "vite": "8.3.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-is": "19.3.1",
    "recharts": "3.10.1",
    "@babel/core": "^7.29.6",
    "@tailwindcss/vite": "^4.1.10",
    "tailwindcss": "^4.1.10",
    "postcss": "^8.5.7",
    "ws": "^8.21.3",
    "yaml": "^2.9.1",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.43.15",
