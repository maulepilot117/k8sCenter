{
  "name": "@k8scenter/frontend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "start": "bun run server/prod.ts",
    "test": "bun test",
    "lint": "biome lint ../",
    "fmt": "biome format --write ../",
    "fmt:check": "biome format ../",
    "check": "biome check ../ && astro check && bun run server/check-no-ws-dev-proxy.ts && bun run server/check-no-signal-store-in-ssr.ts && bun run server/check-island-hydration-directives.ts"
  },
  "dependencies": {
    "astro": "7.3.2",
    "@astrojs/node": "^11.1.5",
    "@astrojs/preact": "^6.0.5",
    "vite": "^7.3.5",
    "@babel/core": "^7.29.6",
    "preact": "^10.28.3",
    "@preact/signals": "^2.7.1",
    "@tailwindcss/vite": "^4.1.10",
    "tailwindcss": "^4.1.10",
    "postcss": "^8.5.7",
    "ws": "^8.21.3",
    "yaml": "^2.8.3",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.40.0",
    "@codemirror/commands": "^6.10.3",
    "@codemirror/language": "^6.12.2",
    "@codemirror/lang-yaml": "^6.1.2",
    "@codemirror/search": "^6.5.11",
    "@codemirror/theme-one-dark": "^6.1.3",
    "ansi_up": "^6.0.2",
    "@xterm/xterm": "^5.5.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-web-links": "^0.11.0",
    "fuse.js": "^7.1.0",
    "d3-force": "^3.0.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@biomejs/biome": "2.5.12",
    "@types/bun": "1.4.1",
    "@types/ws": "^8.18.1",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "picomatch@<2.3.2": "2.3.2",
    "picomatch@>=4 <4.0.4": "4.0.4"
  }
}
