---
import AlertBanner from "../islands/AlertBanner.tsx";
import CommandPalette from "../islands/CommandPalette.tsx";
import IconRail from "../islands/IconRail.tsx";
import KeyboardShortcuts from "../islands/KeyboardShortcuts.tsx";
import QuickActionsFab from "../islands/QuickActionsFab.tsx";
import SecondaryNav from "../islands/SecondaryNav.tsx";
import ToastProvider from "../islands/ToastProvider.tsx";
import TopBarV2 from "../islands/TopBarV2.tsx";
import { shouldBypassChrome } from "../lib/chrome-bypass.ts";
// Three-pane shell, ported from frontend/routes/_layout.tsx: icon rail
// (domains) | collapsible secondary nav (grouped children) | content. The
// secondary panel width is driven by --panel-width, which the SecondaryNav
// island flips to 0px when collapsed (see lib/nav.ts). Collapse is
// instant — no CSS transition on the grid track (per design spec).
//
// U9: the eight chrome islands now live under frontend/src/islands/ (ported
// from frontend/islands/ along with the other 133 uniform islands) and are
// imported directly here, each with client:load — KTD4 requires every
// island hydrate eagerly, and this layout (not a page) is the one place U9
// authors the directive itself, since U8 never reaches it.
//
// NOTE: biome's `--unsafe` noUnusedImports/noUnusedVariables fixer does not
// understand Astro's frontmatter-vs-template split — it deleted every
// import below (and renamed `bypass` to `_bypass`) as "unused" because it
// only sees the fenced frontmatter, not the template's JSX usage. Do not
// run `biome check --write --unsafe` against .astro files; every import
// and binding here IS used, in the template below the second `---`.
import BaseLayout from "./BaseLayout.astro";

interface Props {
  title?: string;
}

const { title } = Astro.props;
const pathname = Astro.url.pathname;
const bypass = shouldBypassChrome(pathname);
---
<BaseLayout title={title}>
  {bypass ? (
    <slot />
  ) : (
    <div
      style="display:grid;grid-template-columns:var(--rail-width, 64px) var(--panel-width, 250px) minmax(0, 1fr);grid-template-rows:var(--topbar-height, 56px) 1fr;height:100dvh;background:transparent;color:var(--text-primary)"
    >
      {/* Icon rail — full height, column 1 */}
      <div style="grid-column:1;grid-row:1 / -1;display:flex">
        <IconRail client:load currentPath={pathname} />
      </div>

      {/* Secondary nav — full height, collapsible, column 2 */}
      <div style="grid-column:2;grid-row:1 / -1;display:flex;overflow:hidden">
        <SecondaryNav client:load currentPath={pathname} />
      </div>

      {/* Top bar — overlays content column (column 3, row 1) */}
      <div style="grid-column:3;grid-row:1;z-index:50;position:relative">
        <TopBarV2 client:load />
      </div>

      {/* Main content — scrolls under the bar (column 3, rows 1/-1) */}
      <main
        class="page-enter"
        style="grid-column:3;grid-row:1 / -1;min-width:0;overflow-y:auto;overflow-x:hidden;padding:calc(var(--topbar-height, 56px) + var(--content-padding, 24px)) var(--content-padding, 24px) var(--content-padding, 24px)"
      >
        <AlertBanner client:load />
        <slot />
      </main>

      <ToastProvider client:load />
      <KeyboardShortcuts client:load />
      <CommandPalette client:load />
      <QuickActionsFab client:load />
    </div>
  )}
</BaseLayout>
