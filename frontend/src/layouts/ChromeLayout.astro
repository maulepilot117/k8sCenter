---
import { shouldBypassChrome } from "../lib/chrome-bypass.ts";
// Three-pane shell, ported from frontend/routes/_layout.tsx: icon rail
// (domains) | collapsible secondary nav (grouped children) | content. The
// secondary panel width is driven by --panel-width, which the SecondaryNav
// island flips to 0px when collapsed (see lib/nav.ts). Collapse is
// instant — no CSS transition on the grid track (per design spec).
//
// Scope note (U7): the eight chrome islands this layout mounts —
// AlertBanner, CommandPalette, IconRail, KeyboardShortcuts,
// QuickActionsFab, SecondaryNav, ToastProvider, TopBarV2 — do not exist
// under frontend/src/ yet (U9 ports them). Each slot below is a
// `U9-ISLAND-SLOT:` comment marker in the exact position the real island
// call site belongs; U9 replaces the marker with the real import + JSX,
// nothing else in this file's structure should need to change. Do NOT
// import from frontend/islands/ here — those files still import
// `fresh/runtime`, which tsconfig.json only redirects for `bun test`
// (IS_BROWSER hardcoded false), not for real rendering.
import BaseLayout from "./BaseLayout.astro";

interface Props {
  title?: string;
}

const { title } = Astro.props;
const pathname = Astro.url.pathname;
const bypass = shouldBypassChrome(pathname);
---
<BaseLayout title={title}>
  {bypass ? (
    <slot />
  ) : (
    <div
      style="display:grid;grid-template-columns:var(--rail-width, 64px) var(--panel-width, 250px) minmax(0, 1fr);grid-template-rows:var(--topbar-height, 56px) 1fr;height:100dvh;background:transparent;color:var(--text-primary)"
    >
      {/* Icon rail — full height, column 1 */}
      <div style="grid-column:1;grid-row:1 / -1;display:flex">
        <!-- U9-ISLAND-SLOT: IconRail client:load currentPath={pathname} -->
      </div>

      {/* Secondary nav — full height, collapsible, column 2 */}
      <div style="grid-column:2;grid-row:1 / -1;display:flex;overflow:hidden">
        <!-- U9-ISLAND-SLOT: SecondaryNav client:load currentPath={pathname} -->
      </div>

      {/* Top bar — overlays content column (column 3, row 1) */}
      <div style="grid-column:3;grid-row:1;z-index:50;position:relative">
        <!-- U9-ISLAND-SLOT: TopBarV2 client:load -->
      </div>

      {/* Main content — scrolls under the bar (column 3, rows 1/-1) */}
      <main
        class="page-enter"
        style="grid-column:3;grid-row:1 / -1;min-width:0;overflow-y:auto;overflow-x:hidden;padding:calc(var(--topbar-height, 56px) + var(--content-padding, 24px)) var(--content-padding, 24px) var(--content-padding, 24px)"
      >
        <!-- U9-ISLAND-SLOT: AlertBanner client:load -->
        <slot />
      </main>

      <!-- U9-ISLAND-SLOT: ToastProvider client:load -->
      <!-- U9-ISLAND-SLOT: KeyboardShortcuts client:load -->
      <!-- U9-ISLAND-SLOT: CommandPalette client:load -->
      <!-- U9-ISLAND-SLOT: QuickActionsFab client:load -->
    </div>
  )}
</BaseLayout>
