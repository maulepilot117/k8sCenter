---
import { isIncidentId } from "../../../../lib/incident-types.ts";
import IncidentWorkspace from "../../../islands/IncidentWorkspace.tsx";
import ChromeLayout from "../../../layouts/ChromeLayout.astro";

// Whether Astro hands the segment over encoded or already decoded, a stray
// "%" must not throw here and 500 the page: fall back to the raw value.
const raw = (Astro.params.id as string | undefined) ?? "";
let id = raw;
try {
  id = decodeURIComponent(raw);
} catch {
  id = raw;
}
// Incident ids are UUIDs. Anything else gets a not-found state here and no
// island, so it can never reach a request path. The page still answers 200
// with its shell, like every detail page for an object that does not exist
// (e2e/tests/route-inventory.spec.ts holds every dynamic route to that).
const valid = isIncidentId(id);
---
<ChromeLayout>
  {valid ? (
    <IncidentWorkspace client:load id={id} />
  ) : (
    <div class="flex flex-col gap-3">
      <a
        href="/observability/incidents"
        class="rounded-sm text-sm text-accent focus:outline-none focus-visible:ring-2 focus-visible:ring-brand/50"
      >
        Incidents
      </a>
      <p role="alert" class="m-0 text-sm text-text-secondary">
        Incident not found. This is not a valid incident id.
      </p>
    </div>
  )}
</ChromeLayout>
