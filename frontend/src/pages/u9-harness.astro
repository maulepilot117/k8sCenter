---
import { CodeMirrorEditor } from "../components/ui/CodeMirrorEditor.tsx";
import PropProbe from "../dev-harness/PropProbe.tsx";
// Render-branch IS_BROWSER islands (return null during SSR, real content
// only once IS_BROWSER flips true post-hydration).
import AuthProviderButtons from "../islands/AuthProviderButtons.tsx";
// A prop-carrying island, matching the shape of real route call sites
// (string props only, per the U9 call-site sweep below).
import CertificateDetail from "../islands/CertificateDetail.tsx";
import CertificatesList from "../islands/CertificatesList.tsx";
import ClusterSwitcher from "../islands/ClusterSwitcher.tsx";
import ClusterTopology from "../islands/ClusterTopology.tsx";
// A large-but-uniform island (per the unit brief: size alone doesn't move
// DashboardV2/ResourceTable/CRDResourceList/IngressWizard out of U9).
import DashboardV2 from "../islands/DashboardV2.tsx";
// U13: the four islands that construct a WebSocket directly, plus
// LogExplorer -- LogLiveTail is never mounted standalone (its `active` /
// `query` / `namespace` / `lines` props are Signal<T> instances owned by
// its parent island, not serializable Astro props), so LogExplorer is
// mounted here instead, exercising LogLiveTail exactly as production does.
import FlowViewer from "../islands/FlowViewer.tsx";
import LogExplorer from "../islands/LogExplorer.tsx";
import LogViewer from "../islands/LogViewer.tsx";
import NamespaceTopology from "../islands/NamespaceTopology.tsx";
import NetworkPolicyWizard from "../islands/NetworkPolicyWizard.tsx";
import PodTerminal from "../islands/PodTerminal.tsx";
import ResourceDetail from "../islands/ResourceDetail.tsx";
import SchemaForm from "../islands/SchemaForm.tsx";
// Effect-guard IS_BROWSER islands (guard is inside a useEffect; SSR output
// is real markup either way).
import ThemeToggle from "../islands/ThemeToggle.tsx";
// U14: widget/custom-layout islands -- the third-party-DOM-lifecycle and
// hand-rolled-SVG-layout risk class (Monaco/CodeMirror editor boundaries,
// ref-timing-dependent topology canvases, CRD-schema-driven forms).
import YamlEditor from "../islands/YamlEditor.tsx";
// Throwaway harness — mounts a curated set of ported islands, each with
// client:load, outside the real route tree (no real page imports them yet;
// U8 authors the production directives two units later). Astro only
// renders/hydrates a component that some page actually imports, so without
// this page U9/U13/U14 have no way to observe their own islands' SSR output
// or hydration behavior.
//
// Location: frontend/src/pages/u9-harness.astro (this file), plus its one
// dev-only helper at frontend/src/dev-harness/PropProbe.tsx. U13 and U14
// add sections here for their own islands rather than building their own
// harness. U8 deletes both once real pages mount these islands for real.
//
// Deliberately built on BaseLayout, not ChromeLayout — ChromeLayout's own
// eight chrome islands (IconRail, SecondaryNav, TopBarV2, AlertBanner,
// ToastProvider, KeyboardShortcuts, CommandPalette, QuickActionsFab) are
// already exercised on every page through frontend/src/pages/index.astro;
// this page isolates a sample of the other 133 so a chrome-island bug and a
// body-island bug are never conflated.
//
// NOTE: do not run `biome check --write --unsafe` against this (or any)
// .astro file — its noUnusedImports/noUnusedVariables fixer does not see
// template usage below the frontmatter fence and will delete every import
// here and rename every const, as it did once already during this unit.
import BaseLayout from "../layouts/BaseLayout.astro";

// Synthetic prop payload for the HTML-metacharacter / XSS test scenario —
// exercised through CertificateDetail's namespace/name props, the same
// shape every real route call site uses today (confirmed by grep across
// frontend/routes: every island prop passed from a route is a string,
// number, or null — none is a Date, Map, function, class instance, or
// signal). See this unit's report for the full sweep.
const dangerousNamespace = '"><img src=x onerror=alert(1)>';
const dangerousName = "<script>alert('xss')</script>";
---
<BaseLayout title="U9 island harness">
  <main style="padding:24px;color:#e5e7eb;background:#05080f;min-height:100vh">
    <h1>U9 island harness (dev-only, deleted by U8)</h1>

    <h2>Render-branch IS_BROWSER (returns null during SSR)</h2>
    <AuthProviderButtons client:load />
    <CertificatesList client:load />

    <h2>Effect-guard IS_BROWSER (real SSR markup, effect gated)</h2>
    <ThemeToggle client:load />
    <ClusterSwitcher client:load />

    <h2>Large uniform island</h2>
    <DashboardV2 client:load />

    <h2>HTML-metacharacter prop (namespace/name, matches real call sites)</h2>
    <CertificateDetail
      client:load
      namespace={dangerousNamespace}
      name={dangerousName}
    />

    <h2>Prop serialization: Date / Map / dangerous string</h2>
    <PropProbe
      client:load
      createdAt={new Date("2026-09-14T08:50:00Z")}
      labels={new Map([["app", "k8scenter"], ["tier", "backend"]])}
      dangerousName={dangerousName}
    />

    <h2>U13: WebSocket-owning islands</h2>
    <p>
      LogViewer and PodTerminal below point at a placeholder pod so SSR never
      attempts a real call. To manually verify streaming against the live
      cluster, edit the namespace/name/containers props to a real running
      pod (e.g. via `kubectl get pods -A`) and reload.
    </p>
    <h3>FlowViewer (owns the Hubble flows socket)</h3>
    <FlowViewer client:load />
    <h3>LogExplorer (mounts LogLiveTail, which owns the logs-search socket)</h3>
    <LogExplorer client:load />
    <h3>LogViewer (owns a per-container logs socket)</h3>
    <LogViewer
      client:load
      namespace="kube-system"
      pod="placeholder-pod"
      containers={["main"]}
    />
    <h3>PodTerminal (owns the exec socket; the only Bearer-at-upgrade route)</h3>
    <PodTerminal
      client:load
      namespace="kube-system"
      name="placeholder-pod"
      containers={["main"]}
    />

    <h2>U14: widget and custom-layout islands</h2>
    <p>
      Data-fetching sections below (topology, SchemaForm, ResourceDetail,
      NetworkPolicyWizard's namespace list) call apiGet on mount like every
      other data island on this page -- unauthenticated, that 401s and
      lib/api.ts redirects to /login. That redirect is existing, correct
      behavior unrelated to this unit; it does not gate whether Monaco or
      CodeMirror mounted, which is this unit's actual risk surface. To watch
      the data states resolve for real, log in first, then reload this page.
    </p>

    <h3>YamlEditor (Monaco, thin island wrapper -- CDN dynamic import)</h3>
    <YamlEditor
      client:load
      value={"apiVersion: v1\nkind: Pod\nmetadata:\n  name: example\n"}
    />

    <h3>
      CodeMirrorEditor (direct import, no island wrapper -- matches
      ResourceDetail's own boundary convention)
    </h3>
    <CodeMirrorEditor
      client:load
      value={"apiVersion: v1\nkind: Pod\nmetadata:\n  name: example\n"}
    />

    <h3>ClusterTopology (hand-rolled SVG layout, no d3-force)</h3>
    <div style="height:260px">
      <ClusterTopology client:load />
    </div>

    <h3>NamespaceTopology (hand-rolled SVG layout, no d3-force)</h3>
    <div style="height:260px">
      <NamespaceTopology client:load />
    </div>

    <h3>SchemaForm (CRD-schema-driven form tree, mounts SchemaFormField)</h3>
    <SchemaForm client:load group="cert-manager.io" resource="certificates" mode="create" />

    <h3>NetworkPolicyWizard (wizard shell -&gt; WizardReviewStep -&gt; Monaco)</h3>
    <NetworkPolicyWizard client:load />

    <h3>ResourceDetail (the CodeMirror call site; placeholder resource so SSR
    never attempts a real call -- edit kind/name/namespace to a real
    resource and reload to see the YAML tab's CodeMirrorEditor mount for
    real)</h3>
    <ResourceDetail
      client:load
      kind="pods"
      name="placeholder-pod"
      namespace="kube-system"
      title="Pod"
    />
  </main>
</BaseLayout>
