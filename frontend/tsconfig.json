{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      // Recreates deno.json's `"@/": "./"` import-map entry (U3 approach
      // step 2) now that Astro/Bun resolve `@/` from real dependency
      // resolution rather than an import map.
      "@/*": ["./*"],
      // U4 test-only shim: `lib/cluster.ts` imports `fresh/runtime`, a jsr:
      // specifier only Deno's import map (deno.json) can resolve. Bun has
      // no import map, so `bun test` needs this redirect to load
      // cluster.ts (and api.ts, which imports it). Real Deno/Fresh builds
      // are unaffected — deno.json's import map still wins there. Remove
      // this entry, and lib/__shims__/fresh-runtime.ts, once cluster.ts
      // stops importing fresh/runtime.
      "fresh/runtime": ["./lib/__shims__/fresh-runtime.ts"]
    },
    "jsx": "preserve",
    "jsxImportSource": "preact",
    // U5: without an explicit "types" array, `astro check` doesn't pick up
    // @types/bun's ambient "bun:test" module declaration on its own (it
    // resolves fine for plain `tsc`/editors, just not through astro
    // check's programmatic invocation) -- needed once frontend/server's
    // *_test.ts files entered this project via "include" below.
    "types": ["bun-types"]
  },
  // Scoped to what has actually been ported off Fresh/Deno (see the U3
  // check-gate scope note in astro.config.mjs). frontend/routes, islands,
  // components, lib, main.ts etc. still import `fresh` / `fresh/runtime`
  // (jsr: specifiers) and are type-checked by `deno check` until U12
  // deletes deno.json. This include list widens as U7 through U9 move
  // files into src/. "server" was added in U5: it is Bun/Astro-only
  // runtime code with no Deno equivalent, so it is type-checked here
  // rather than by `deno check` (see deno.json's matching exclude entry).
  "include": ["src", "astro.config.mjs", "server", "../tools/theme-gen/main.ts"]
}
